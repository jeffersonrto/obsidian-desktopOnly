    "test": "node --test tests/enforcer.test.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "desktop-only"
  ],
  "author": "Jeff",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "tslib": "^2.7.0",
    "typescript": "^5.6.0"
  }
}
